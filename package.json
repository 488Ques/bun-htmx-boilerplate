{
  "name": "bun-htmx-boilerplate",
  "type": "module",
  "scripts": {
    "css:build": "tailwindcss -i ./public/css/base.css -o ./public/css/app.css",
    "css:watch": "tailwindcss -i ./public/css/base.css -o ./public/css/app.css --watch",
    "dev:server": "bun run --hot src/index.ts",
    "dev": "concurrently -n css,server -c auto \"bun run css:watch\" \"bun run dev:server\"",
    "build": "bun run css:build && bun build ./src/index.ts --minify --outdir ./dist",
    "start": "bun run dist/index.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "db:codegen": "kysely-codegen --dialect postgres --camel-case --out-file src/db/types.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "hono": "^4.12.14",
    "kysely": "^0.28.16",
    "pg": "^8.20.0",
    "tailwindcss": "^4.2.2",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@tailwindcss/cli": "^4.2.2",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "concurrently": "^9.2.1",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.20.0",
    "typescript": "^6.0.3"
  }
}
